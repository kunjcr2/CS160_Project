# Copy to .env and fill in real values. NEVER commit .env.
DATABASE_URL=postgresql+psycopg://cs160:your-password@localhost:5432/voice_assistant
TEST_DATABASE_URL=postgresql+psycopg://cs160:your-password@localhost:5432/voice_assistant_test

FAKE_AI=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
OPENAI_MAX_OUTPUT_TOKENS=120
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

JWT_SECRET=generate-a-long-random-string

# TEMPORARY until auth (S2-03): set true locally to act as a user by sending an
# X-User-Id header. Never enable it anywhere else.
DEV_USER_HEADER=false

# Reminder worker: true runs it inside the API process (one terminal). Otherwise run
# `python -m app.workers.reminders` in a second terminal.
RUN_REMINDER_WORKER=false

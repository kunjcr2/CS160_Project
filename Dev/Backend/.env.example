# Copy to .env and fill in real values. NEVER commit .env.
DATABASE_URL=postgresql+psycopg://cs160:your-password@localhost:5432/voice_assistant
TEST_DATABASE_URL=postgresql+psycopg://cs160:your-password@localhost:5432/voice_assistant_test

FAKE_AI=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
OPENAI_MAX_OUTPUT_TOKENS=120
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy


# Required: a random string, at least 32 bytes. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=generate-a-long-random-string


# How long a signed-in device stays signed in without logging in again.
REFRESH_TOKEN_DAYS=90

# Cookie "Secure" flag defaults to true (plan §5.1: https only). Set to false
# only for local http development.
COOKIE_SECURE=false

# Mock doctor's office: delay per call, and share of calls that fail (0.0 to 1.0).
MOCK_PROVIDER_LATENCY_MS=0
MOCK_PROVIDER_FAILURE_RATE=0.0

# Rate limit on /auth/login, /auth/register, /auth/pair: tries allowed per IP per window.
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=60
